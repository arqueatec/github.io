# String de conexão PostgreSQL (Neon, Supabase, Vercel Postgres, RDS...).
# Em produção na Vercel use a URL *pooled* (pgbouncer) do provedor.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ovinos

# Banco usado SOMENTE pelos testes de integração (é apagado e recriado a cada execução).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ovinos_test

# Segredo usado para assinar/derivar tokens de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=troque-por-um-valor-aleatorio-de-32-bytes-ou-mais

# Duração da sessão em dias (opcional, padrão 30)
SESSION_DAYS=30

# Opcional: cria o administrador inicial com `npm run admin:create`
# (alternativa: acessar /setup no primeiro acesso, quando não há usuários)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha
